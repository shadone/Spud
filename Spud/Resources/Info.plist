<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Spud</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleIcons</key>
	<dict>
		<!-- Primary icon stays in the asset catalog (ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon); -->
		<!-- only the loose-PNG alternates are declared here. Each file basename must match the -->
		<!-- bundle-root PNGs (AppIcon-<Name>@2x.png / @3x.png), and is what setAlternateIconName -->
		<!-- expects (the @Nx and .png suffixes are implied). -->
		<key>CFBundleAlternateIcons</key>
		<dict>
			<key>Midnight</key>
			<dict>
				<key>CFBundleIconFiles</key>
				<array>
					<string>AppIcon-Midnight</string>
				</array>
				<key>UIPrerenderedIcon</key>
				<false/>
			</dict>
			<key>Forest</key>
			<dict>
				<key>CFBundleIconFiles</key>
				<array>
					<string>AppIcon-Forest</string>
				</array>
				<key>UIPrerenderedIcon</key>
				<false/>
			</dict>
			<key>Sunset</key>
			<dict>
				<key>CFBundleIconFiles</key>
				<array>
					<string>AppIcon-Sunset</string>
				</array>
				<key>UIPrerenderedIcon</key>
				<false/>
			</dict>
			<key>Mono</key>
			<dict>
				<key>CFBundleIconFiles</key>
				<array>
					<string>AppIcon-Mono</string>
				</array>
				<key>UIPrerenderedIcon</key>
				<false/>
			</dict>
		</dict>
	</dict>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.social-networking</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save images from Spud to your photo library.</string>
	<!-- Spud does not use location. These strings are required only because a -->
	<!-- bundled dependency (GRDB) links Apple's CoreLocation framework; the app -->
	<!-- never requests location authorization, so this prompt is never shown. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Spud does not use your location.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Spud does not use your location.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>info.ddenis.Spud</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>info.ddenis.spud</string>
			</array>
		</dict>
	</array>
	<key>NSUserActivityTypes</key>
	<array>
		<string>info.ddenis.Spud.viewPost</string>
		<string>info.ddenis.Spud.viewCommunity</string>
		<string>info.ddenis.Spud.viewPerson</string>
	</array>
	<!-- Post Reminders Phase 4: lets a "new comments" activity follow poll and -->
	<!-- fire a notification even while the app is closed. No paid entitlement - -->
	<!-- `fetch` background mode + the declared task identifier below is all a -->
	<!-- BGAppRefreshTask needs. Timing is OS-opportunistic (see -->
	<!-- ReminderBackgroundRefresh's doc comment). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>info.ddenis.Spud.reminderPoll</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
